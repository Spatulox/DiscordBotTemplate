{
  "name": "discord-bot-template",
  "version": "1.0.0",
  "description": "Discord bot template built on @spatulox/simplediscordbot",
  "main": "./dist/bot_one/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "clear && npm run build && npm run startjs",
    "startjs": "concurrently \"node ./dist/bot_one/src/index.js\" \"node ./dist/bot_two/src/index.js\"",
    "dev": "concurrently \"npm run bot_one\" \"npm run bot_two\"",
    "bot_one": "nodemon -e ts --exec ts-node src/bot_one/src/index.ts",
    "bot_two": "nodemon -e ts --exec ts-node src/bot_two/src/index.ts",
    "dim": "dim"
  },
  "author": "Spatulox",
  "license": "ISC",
  "dependencies": {
    "@discordjs/builders": "^1.9.0",
    "@spatulox/discord-module": "^0.10.1",
    "@spatulox/simplediscordbot": "^3.0.2",
    "concurrently": "^9.2.1",
    "discord.js": "^14.26.0",
    "discord.js-rate-limiter": "^1.3.2",
    "dotenv": "^17.3.1",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/node-schedule": "^2.1.7",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": []
}
